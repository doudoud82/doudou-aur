pkgname=doudou-system-config
pkgver=1.0
pkgrel=1
pkgdesc="Doudou Arch Linux configuration files for system"
arch=('any')
install="doudou-system-config.install"
depends=(
    'snapper'
    'fwupd'
    'sbctl'
)

package(){

    local dest="$pkgdir/usr/share/doudou/system/config"
    install -d "$pkgdir/usr/share/doudou/system"
    cp -a --no-preserve=ownership "$startdir/config" "$dest"

    chmod 0750 "$dest/etc/sudoers.d"
    chmod 0440 "$dest/etc/sudoers.d/"*
    chmod 0640 "$dest/etc/snapper/configs/root"
    chmod 0755 "$dest/usr/local/lib/post-install.sh"
    }