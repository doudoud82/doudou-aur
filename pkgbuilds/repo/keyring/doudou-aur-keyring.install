post_install() {
    if usr/bin/pacman-key -l >/dev/null 2>&1; then
        usr/bin/pacman-key --populate doudou-aur
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    if [ -x /usr/bin/pacman-key ]; then
        usr/bin/pacman-key --delete 093CEA480F11E0A613AF2CFB063F6A5182A1B15D 2>/dev/null || true
    fi
}