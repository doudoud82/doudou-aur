pkgname=doudou-live-environment
pkgver=1.0
pkgrel=1
pkgdesc="Doudou Arch Linux live environment"
arch=('any')
depends=(
    'bash'
    'doudou-aur-keyring'
    'doudou-aur-mirrorlist'
    'firefox'
    'gparted'
    'gtkmm3'
    'gvfs'
    'iptables'
    'libglvnd'
    'mesa'
    'mousepad'
    'network-manager-applet'
    'networkmanager'
    'papirus-icon-theme'
    'rate-mirrors'
    'thunar'
    'tumbler'
    'xfce4-panel'
    'xfce4-session'
    'xfce4-settings'
    'xfce4-terminal'
    'xfdesktop'
    'xfwm4'
    'xorg-server'
)


package(){
    cd "$startdir/files"

    cp -a --no-preserve=ownership etc usr "$pkgdir/"
    
    find "$pkgdir" -type d -exec chmod 755 {} +
    find "$pkgdir" -type f -exec chmod 644 {} +

    chmod 750 "$pkgdir/etc/sudoers.d"
    chmod 440 "$pkgdir/etc/sudoers.d/10-liveuser"
    chmod 755 "$pkgdir/usr/local/bin/trust-desktop-launchers"
    chmod 755 "$pkgdir/etc/skel/Desktop/GParted.desktop" \
              "$pkgdir/etc/skel/Desktop/Install System.desktop"

}