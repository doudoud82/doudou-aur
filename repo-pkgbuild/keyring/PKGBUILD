pkgdesc="Keyring for personal repo doudou-aur"
arch=('any')
url="https://github.com/doudoud82/doudou-aur"
license=('MIT')
install=doudou-aur-keyring.install
source=('doudou-aur-keyring.install'
        'doudou-aur.gpg'           # Your exported public key
        'doudou-aur-trusted')      # Trust levels file
sha256sums=('9f220d839c5f47a12d301c83023ade126b1c7a6e5fbdc440872e3b07eadd9167'
            'cd3fd734a41b3a823dd20c7aef787ac6234cc4f1c23c2434348ed5e4b46ca38c'
            '6d5676f9f9a5fbe0c8010f80f940de5109c3c17e90a35f12a8b7006a468cb0d2')

package() {
    # Install keyring
    install -Dm644 "$srcdir/doudou-aur.gpg" \
        "$pkgdir/usr/share/pacman/keyrings/doudou-aur.gpg"
    
    # Install trusted keys list
    install -Dm644 "$srcdir/doudou-aur-trusted" \
        "$pkgdir/usr/share/pacman/keyrings/doudou-aur-trusted"
}